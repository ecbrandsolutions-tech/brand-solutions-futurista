# MARKETING CLOUD AI — plantilla de variables de entorno
# Copia este archivo como .env.local (local) o configúralas en Vercel.
# NUNCA subas .env.local a GitHub. Aquí no debe haber valores reales.

# ---------- App ----------
# URL pública de la app (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Fase 3) ----------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Meta Marketing API (Fase 4) ----------
# developers.facebook.com > tu app > Configuración > Básica
META_APP_ID=
# SOLO servidor.
META_APP_SECRET=
# Versión de la Graph API (formato vXX.X). Verifica la vigente en la documentación de Meta.
META_GRAPH_API_VERSION=

# Clave para cifrar los tokens de Meta en la base de datos (32 bytes en base64).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------- IA opcional (Fase 9) ----------
# Desactivada por defecto. Solo se usa si AI_ENABLED=true y hay API key.
AI_ENABLED=false
OPENAI_API_KEY=
